# MedAI Hospital web app — environment template
# Copy to apps/web/.env for local builds, or set these in
# Render → your static site service → Environment.
#
# VITE_* values are baked into the JavaScript bundle at build time,
# so the site must be rebuilt after any change here.

# Public base URL of the API (no trailing slash, no /api suffix).
# Local development:
# VITE_API_URL=http://localhost:8080
# Production:
VITE_API_URL=https://medaionline-1.onrender.com
