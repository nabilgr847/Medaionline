{
  "appId": "com.medai.hospital",
  "appName": "MedAI Hospital",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#092b46",
    "buildOptions": {
      "release": {
        "keystoreFile": "../../medai-release.jks",
        "keystorePassword": "medaiapp2026",
        "keyAlias": "medai",
        "keyPassword": "medaiapp2026"
      }
    }
  },
  "plugins": {
