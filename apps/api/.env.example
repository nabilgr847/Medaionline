# ============================================================================
#  MedAI Hospital API — environment template
#  Copy to apps/api/.env for local runs, or paste these keys into
#  Render → your API service → Environment.
#
#  Required (the API refuses to start without them):
#    MONGODB_URI, JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD, CLIENT_ORIGIN
# ============================================================================

# ---- core -------------------------------------------------------------------
NODE_ENV=production
PORT=10000                       # Render injects PORT itself; leave unset there

# MongoDB connection string (Atlas: mongodb+srv://user:pass@cluster.mongodb.net/medai)
MONGODB_URI=

# Long random string used to sign session tokens (32+ characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- first admin account ----------------------------------------------------
ADMIN_EMAIL=                     # the account seeded on first boot
ADMIN_PASSWORD=                  # 12+ characters
ADMIN_RECOVERY_KEY=              # printed once at boot; used for admin recovery
REQUIRE_ADMIN_APPROVAL=false     # true = doctors wait for admin approval

# ---- URLs -------------------------------------------------------------------
# Where the API itself is reachable (used in emails and WebRTC config)
APP_PUBLIC_URL=https://medaionline-1.onrender.com
# Comma-separated list of browser origins allowed to call the API.
# Example: https://medaionline-1.onrender.com,https://medai-preview.onrender.com
# The Android app (WebView on https://localhost) is always allowed — do not add it.
CLIENT_ORIGIN=https://medaionline-1.onrender.com

# ---- uploads ----------------------------------------------------------------
# On Render mount a 1 GB disk at /var/data and keep this inside it,
# otherwise uploaded reports disappear on every deploy.
UPLOAD_DIR=/var/data/uploads
MAX_UPLOAD_MB=12

# ---- email (Gmail app password or any SMTP provider) -----------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=                       # 16-character Gmail app password, not the login password
SMTP_FROM=MedAI Hospital <your.address@gmail.com>

# ---- AI (OpenRouter) --------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_VISION_MODEL=
AI_LIMIT_PER_HOUR=30

# ---- video calls (TURN / coturn) -------------------------------------------
TURN_URLS=turn:your.turn.host:3478
TURN_SHARED_SECRET=              # preferred: time-limited credentials
TURN_USERNAME=                   # fallback: static credentials
TURN_CREDENTIAL=

# ---- prescription signing (run: npm run generate-signing-keys) -------------
PRESCRIPTION_SIGNING_PRIVATE_KEY=
PRESCRIPTION_SIGNING_PUBLIC_KEY=
PRESCRIPTION_SIGNING_PRIVATE_KEY_BASE64=
PRESCRIPTION_SIGNING_PUBLIC_KEY_BASE64=

# ---- payments (optional — only needed for paid plans) ----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_USERNAME=
NAGAD_PASSWORD=

# ---- SMS / 2FA (optional) ---------------------------------------------------
# SMS_PROVIDER: none | twilio | msg91
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_API_KEY=
MSG91_SENDER_ID=

# ---- misc -------------------------------------------------------------------
APP_NAME=MedAI Hospital
SUPPORT_EMAIL=support@example.com
HOSPITAL_TZ_OFFSET_MIN=360       # Bangladesh = UTC+6
