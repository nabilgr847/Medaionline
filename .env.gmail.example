# --- Gmail (App Password) for verification codes, password reset and notification emails ---
# 1) Google Account > Security > turn on 2-Step Verification
# 2) Google Account > Security > App passwords > create one (16 letters, spaces are ignored)
SMTP_USER=yourname@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
# Optional (these are the defaults when SMTP_USER is set):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=MedAI Hospital <yourname@gmail.com>
# Public URL of the web app (used in email links)
APP_PUBLIC_URL=https://your-medai-site.example
# false (default): the patient's account opens right after entering the emailed code.
# true: after the code, the admin must still approve the account (Requests > New accounts).
REQUIRE_ADMIN_APPROVAL=false
